# ═══════════════════════════════════════════════════════════════════
# Server 4 — Scraper Engine .env Template
# Place this file at /opt/reviewmate/.env on the scraper server
# ═══════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=<your-db-server>
DB_NAME=ScraperEngine
DB_UID=<your-db-user>
DB_PWD=<your-db-password>
DB_ENCRYPT=yes
DB_TRUST_CERT=yes

# ── Backend Integration ────────────────────────────────────────────
BACKEND_API_URL=https://api.reviewmate.live

# ── Rate Limiting ──────────────────────────────────────────────────
MAX_QUEUE_SIZE=100
RATE_LIMIT_SCRAPE=10/minute
RATE_LIMIT_GLOBAL=100/minute

# ── Platform Delays (seconds) ──────────────────────────────────────
DELAY_GOOGLE=30.0
DELAY_AGODA=20.0
DELAY_BOOKING=20.0
DELAY_TRIPADVISOR=40.0
