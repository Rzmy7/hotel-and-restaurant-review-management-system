# ═══════════════════════════════════════════════════════════════════
# Server 2 — Backend .env Template
# Place this file at /opt/reviewmate/.env on the backend server
# ═══════════════════════════════════════════════════════════════════

# ── General ─────────────────────────────────────────────────────────
SECRET_KEY=<generate-a-strong-random-key>
FRONTEND_URL=https://reviewmate.live

# ── CORS (comma-separated production origins) ──────────────────────
CORS_ORIGINS=https://reviewmate.live,https://admin.reviewmate.live

# ── SQLAlchemy ──────────────────────────────────────────────────────
DATABASE_URL=mssql+pyodbc://<user>:<password>@<server>/ScraperEngine?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&Encrypt=no

# ── PYODBC ──────────────────────────────────────────────────────────
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=<your-db-server>
DB_NAME=ScraperEngine
DB_UID=<your-db-user>
DB_PWD=<your-db-password>

# ── SMTP ────────────────────────────────────────────────────────────
SMTP_EMAIL=<your-smtp-email>
SMTP_PASSWORD=<your-app-password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Google OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# ── JWT ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=<generate-a-long-random-string>

# ── Google Generative AI (Gemini) ───────────────────────────────────
GENAI_KEY=<your-gemini-api-key>

# ── Supabase ────────────────────────────────────────────────────────
SUPABASE_URL=<your-supabase-url>
SUPABASE_KEY=<your-supabase-anon-key>
SUPABASE_BUCKET=profile-images

# ── Microservice URLs (point to the other servers) ──────────────────
SCRAPER_ENGINE_URL=https://scrape.reviewmate.live
EMBEDDING_SERVICE_URL=https://embed.reviewmate.live
