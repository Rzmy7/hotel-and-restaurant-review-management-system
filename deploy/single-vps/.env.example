# ═══════════════════════════════════════════════════════════════════
# Single VPS Deployment — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env in the project root and fill in your values.
# Usage:  cp deploy/single-vps/.env.example .env
# ═══════════════════════════════════════════════════════════════════

# ── External Database Configuration ──────────────────────────────
DB_SERVER=your_external_db_ip_or_domain
DB_PORT=1433
DB_NAME=ReviewMate
DB_UID=sa
DB_PWD=YourSecureExternalPassword123!
DB_ENCRYPT=yes

# ── JWT & Security Keys ──────────────────────────────────────────
JWT_SECRET_KEY=your_long_random_jwt_signing_key_here
SECRET_KEY=your_app_secret_key_here

# ── SMTP (Email service for password resets) ─────────────────────
# If using Gmail, generate an App Password: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Google OAuth (Sign in with Google) ───────────────────────────
# Register at: https://console.cloud.google.com/apis/credentials
# Add callback URL: http://<VPS_IP>:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Supabase (Profile photo & Organization logo storage) ─────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_BUCKET=your-storage-bucket-name

# ── Internal Service-to-Service API Key ──────────────────────────
# All microservices authenticate with each other using this shared key.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=generate-a-long-random-key-for-service-auth

# ── Message Broker (RabbitMQ) ───────────────────────────────────
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
# RABBITMQ_URL is resolved dynamically to RabbitMQ container by default. Update if using external broker:
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ── LLM Encryption Key (optional — for LLM gateway feature) ─────
# Generate: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
LLM_ENCRYPTION_KEY=

# ── Domain & SSL Configuration ───────────────────────────────────
# Root domain name (defaults to reviewmate.live if left empty)
DOMAIN_NAME=reviewmate.live

# Email address for Let's Encrypt certificate registration and expiration alerts
CERTBOT_EMAIL=your-email@example.com

# VPS public IP (for DNS validation and fallback reference)
VPS_IP=165.22.245.84

# ── Scraper Engine Settings (optional) ───────────────────────────
# Max jobs allowed in the scraper queue before rejecting requests
MAX_QUEUE_SIZE=100
# Rate limits for the scraper endpoints (using SlowAPI formats)
RATE_LIMIT_SCRAPE=10/minute
RATE_LIMIT_GLOBAL=100/minute
# Delay between requests (in seconds) to avoid platform bans
DELAY_GOOGLE=30.0
DELAY_AGODA=20.0
DELAY_BOOKING=20.0
DELAY_TRIPADVISOR=40.0
