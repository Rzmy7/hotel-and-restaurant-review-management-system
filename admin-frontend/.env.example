# ── Admin Frontend Environment Variables ─────────────────────────────
# Copy this file to .env and fill in the values for your environment.

# Main backend API URL
VITE_MAIN_BACKEND_URL=http://localhost:8000

# Scraping engine URL (direct access for file uploads & health checks)
VITE_SCRAPING_URL=http://localhost:8001

# Embedding service URL (direct access for config & health checks)
VITE_EMBEDDING_SERVICE_URL=http://localhost:8002

# User frontend URL (for "Go to Site" links & monitoring)
VITE_FRONTEND_URL=http://localhost:5173

# Note: Service URLs can also be overridden at runtime through
# the admin panel (API Management page). Those values are stored
# in localStorage and take priority over these env vars.
