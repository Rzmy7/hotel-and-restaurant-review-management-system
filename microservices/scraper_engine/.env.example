# ============================================
# Database Configuration
# ============================================
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
DB_NAME=ScraperEngine
DB_UID=sa
DB_PWD=your_password
DB_ENCRYPT=yes
DB_TRUST_CERT=yes

# ============================================
# API Protection & Rate Limiting
# ============================================
MAX_QUEUE_SIZE=100
RATE_LIMIT_SCRAPE=10/minute
RATE_LIMIT_GLOBAL=100/minute

# ============================================
# Platform-Specific Delays (Seconds between scrapes)
# ============================================
DELAY_GOOGLE=30.0
DELAY_AGODA=20.0
DELAY_BOOKING=20.0
DELAY_TRIPADVISOR=40.0

BACKEND_API_URL=http://127.0.0.1:8000

# ============================================
# Message Broker Configuration
# ============================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/


# ============================================
# Internal Service Authentication
# ============================================
# The keys this scraper accepts to trigger manual scrapes
SCRAPER_API_KEYS=dev-internal-secret
# The key this scraper sends back to the Backend for webhook updates
BACKEND_API_KEY=dev-internal-secret
